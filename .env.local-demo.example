ASTRAVECTOR_MODEL_PATH=/absolute/path/to/model.onnx
ASTRAVECTOR_TOKENIZER_PATH=/absolute/path/to/tokenizer.json
ASTRAVECTOR_MODEL_SHA256=
ASTRAVECTOR_TOKENIZER_SHA256=

DATABASE_URL=postgres://astravector:astravector@127.0.0.1:55432/astravector
ASTRAVECTOR_DB_URL=postgres://astravector:astravector@127.0.0.1:55432/astravector

ASTRAVECTOR_QDRANT_URL=http://127.0.0.1:6333
ASTRAVECTOR_QDRANT_COLLECTION=astravector_local_demo

ASTRAVECTOR_CONFIG=config/application.yaml
ASTRAVECTOR_PROFILE=local-demo
ASTRAVECTOR_ACCESS_ZONE_REGISTRY_AUTO_CREATE_ON_INGESTION=true
ASTRAVECTOR_ACCESS_ZONE_REGISTRY_AUTO_CREATE_ON_SEARCH=false

ASTRAVECTOR_LOCAL_DEMO_GRPC_ADDR=127.0.0.1:50051
ASTRAVECTOR_LOCAL_DEMO_METRICS_URL=http://127.0.0.1:9090
ASTRAVECTOR_LOCAL_DEMO_ACCESS_ZONE_CODE=0488


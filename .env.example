ASTRAVECTOR_CONFIG=config/application.yaml
ASTRAVECTOR_DB_URL=postgres://astravector:astravector@localhost:5432/astravector
ASTRAVECTOR_QDRANT_URL=http://127.0.0.1:6333
ASTRAVECTOR_QDRANT_COLLECTION=astravector_v004
ASTRAVECTOR_MODEL_SHA256=
ASTRAVECTOR_TOKENIZER_SHA256=
RUST_LOG=astravector_runtime=info,tower_http=info

# Smoke/local defaults are documented in smoke-tests/v004/.env.smoke.example.
# Test-only failpoints must stay disabled outside smoke runs.
ASTRAVECTOR_SMOKE_FAILPOINTS_ENABLED=false
ASTRAVECTOR_SMOKE_QDRANT_FAIL_MODE=none
ASTRAVECTOR_SMOKE_QDRANT_FAIL_COUNT=0

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astravector.local/schemas/fix486-document.schema.json",
  "title": "FIX486 hierarchical document fixture",
  "type": "object",
  "required": ["logical_document_id", "versions"],
  "properties": {
    "logical_document_id": {"type": "string", "minLength": 1},
    "external_document_id": {"type": "string"},
    "title": {"type": "string"},
    "source_uri": {"type": "string"},
    "source_type": {"type": "string"},
    "mime_type": {"type": "string"},
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["document_version", "expected_state", "blocks"],
        "properties": {
          "document_version": {"type": "integer", "minimum": 1},
          "expected_state": {"type": "string"},
          "purpose": {"type": "string"},
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["block_id", "block_type", "order_index"],
              "properties": {
                "block_id": {"type": "string"},
                "parent_block_id": {"type": "string"},
                "block_type": {"type": "string"},
                "order_index": {"type": "integer", "minimum": 0},
                "text": {"type": "string"},
                "text_generation": {"type": "object"},
                "source_location": {"type": "object"},
                "expected_hierarchy": {"type": "object"}
              },
              "oneOf": [
                {"required": ["text"]},
                {"required": ["text_generation"]}
              ],
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AstraVector Quality Document",
  "type": "object",
  "required": [
    "schema_version",
    "document_id",
    "title",
    "corpus",
    "access_zone_code",
    "access_level",
    "blocks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "document_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "corpus": {
      "type": "string"
    },
    "access_zone_code": {
      "type": "string"
    },
    "access_level": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ttl_days": {
      "type": [
        "integer",
        "null"
      ]
    },
    "legal_hold": {
      "type": "boolean"
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "block_id",
          "type",
          "text"
        ],
        "properties": {
          "block_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "heading": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

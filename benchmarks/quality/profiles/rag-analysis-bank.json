{
  "schema_version": "1.0",
  "name": "rag-analysis-bank",
  "description": "Controlled smoke corpus for retrieval and graph diagnostics",
  "corpora": ["rag-analysis-bank"],
  "queries": ["rag-analysis-bank-golden"],
  "runner": {
    "mode": "remote-runtime",
    "ingestion": "grpc",
    "concurrency": 2,
    "timeout_seconds": 300
  },
  "thresholds": {
    "recall_at_5": 0.90,
    "expected_document_hit_rate": 0.90,
    "expected_block_hit_rate": 0.85,
    "cross_zone_leakage_count": 0,
    "access_level_violation_count": 0,
    "forbidden_block_leakage_count": 0,
    "hard_negative_false_positive_rate": 0.0,
    "graph_expected_related_hit_rate": 1.0,
    "mmr_expected_aspect_coverage": 0.66,
    "p95_retrieve_context_ms": 5000,
    "outbox_dead_letter_count": 0,
    "qdrant_missing_points": 0
  }
}
